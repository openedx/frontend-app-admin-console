{
  "name": "@openedx/frontend-app-admin-console",
  "version": "1.0.0",
  "description": "Frontend Admin Console",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openedx/frontend-app-admin-console.git"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "/dist"
  ],
  "browserslist": [
    "extends @edx/browserslist-config"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build": "make build",
    "build:ci": "make build-ci",
    "clean": "make clean",
    "i18n_extract": "openedx formatjs extract",
    "lint": "openedx lint .",
    "lint:fix": "openedx lint --fix .",
    "prepack": "npm run clean && npm run build",
    "snapshot": "openedx test --updateSnapshot",
    "start": "fedx-scripts webpack-dev-server --progress",
    "start:with-theme": "paragon install-theme && npm start && npm install",
    "dev": "PORT=2025 PUBLIC_PATH=/admin-console openedx dev",
    "test": "openedx test --coverage --passWithNoTests",
    "types": "tsc --noEmit",
    "translations:pull": "openedx translations:pull"
  },
  "atlasTranslations": {
    "path": "translations/frontend-app-admin-console/src/i18n/messages",
    "dependencies": [
      "@openedx/frontend-base"
    ]
  },
  "author": "Open edX",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/openedx/frontend-app-admin-console#readme",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/openedx/frontend-app-admin-console/issues"
  },
  "peerDependencies": {
    "@edx/brand": "npm:@openedx/brand-openedx@^1.2.3",
    "@edx/openedx-atlas": "^0.7.0",
    "@openedx/frontend-base": "^1.0.1 || 0.0.0-dev",
    "@openedx/paragon": "^23.15.1",
    "@tanstack/react-query": "5.96.2",
    "lodash.debounce": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.1.2",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@edx/browserslist-config": "^1.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "ts-jest": "^29.4.5",
    "tsc-alias": "^1.9.1"
  },
  "overrides": {
    "react-intl": "6.8.9"
  },
  "dependencies": {
    "@openedx/frontend-app-notifications": "^3.0.0"
  }
}
